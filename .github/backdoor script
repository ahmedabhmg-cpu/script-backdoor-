local function createTween(object, properties, duration)
    local tweenInfo = TweenInfo.new(duration or 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(object, tweenInfo, properties)
    tween:Play()
    return tween
end

local function generateName(length)
    local text = ''
    for i = 1, length do
        text = text .. alphabet[math.random(1,#alphabet)]
    end
    return text
end

local function updateStatus(message, color)
    Labely.Text = "Status: " .. message
    Labely.TextColor3 = color or Color3.fromRGB(255, 255, 255)
end

local function buttonClickEffect(button)
    createTween(button, {BackgroundColor3 = Color3.fromRGB(255, 155, 55)}, 0.1)
    task.wait(0.1)
    createTween(button, {BackgroundColor3 = Color3.fromRGB(0, 0, 0)}, 0.1)
end

local function runRemote(remote, data)
    if not remote then return end
    if remote:IsA("RemoteEvent") then
        remote:FireServer(data)
    elseif remote:IsA("RemoteFunction") then
        task.spawn(function()
            remote:InvokeServer(data)
        end)
    end
end

